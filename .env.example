# Copy this file to .env and replace placeholders. Never commit the real .env.

# Application
APP_ENV=development
APP_NAME=Enterprise Knowledge Base
API_HOST=127.0.0.1
IMPORT_SERVICE_PORT=8000
QUERY_SERVICE_PORT=8001

# Logging
LOG_LEVEL=INFO
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
LOG_JSON=False
LOG_SENSITIVE_CONTENT=False

# Browser/API security
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001,http://localhost:8000,http://localhost:8001
CORS_ALLOW_CREDENTIALS=False
AUTH_ENABLED=False
# Generic OIDC/OAuth 2.0 access-token validation. Required in production.
OIDC_ENABLED=False
OIDC_ISSUER_URL=https://id.example.com/realms/enterprise
OIDC_CLIENT_ID=enterprise-rag-assistant
OIDC_AUDIENCE=enterprise-rag-api
OIDC_JWKS_CACHE_SECONDS=300
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_HTTP_TIMEOUT_SECONDS=5
# Comma-separated keys. Generate long random values before enabling auth.
# These static keys are for development compatibility, not human production login.
ADMIN_API_KEYS=
USER_API_KEYS=
READONLY_API_KEYS=
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# DashScope/OpenAI-compatible model API
OPENAI_API_KEY=replace-with-a-new-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
VL_MODEL=qwen3-vl-flash
LLM_TEMPERATURE=0.1
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_CIRCUIT_BREAKER_FAILURES=5
MODEL_CIRCUIT_BREAKER_RESET_SECONDS=30
LLM_ALLOWED_MODELS=qwen-max,qwen-plus,qwen-flash,qwen3-vl-flash
LLM_FALLBACK_MODELS=qwen-plus,qwen-flash

# Embedding and rerank
EMBEDDING_MODEL=BAAI/bge-m3
BGE_M3_PATH=D:/ai_models/modelscope_cache/models/models/BAAI--bge-m3/snapshots/master
BGE_DEVICE=cpu
BGE_FP16=False
EMBEDDING_DIMENSION=1024
RERANK_ENABLED=True
RERANK_MODEL=qwen3-rerank
RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落
RERANK_TOP_N=30
HYDE_ENABLED=True
RETRIEVAL_CANDIDATE_LIMIT=10
RETRIEVAL_TOP_K=5
# Server-side knowledge-base scoping is enabled by default and must stay enabled.
KNOWLEDGE_BASE_FILTER_ENABLED=True
ANSWER_MIN_EVIDENCE_CHUNKS=1
ANSWER_MIN_RELEVANCE_SCORE=0.2
CITATION_MAX_COUNT=5
ANSWER_CONTEXT_MAX_CHARS=12000

# MinerU
MINERU_API_TOKEN=replace-with-mineru-token
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=0
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
HF_HOME=D:/ai_models/huggingface_cache

# Milvus (MILVUS_URL remains accepted as a legacy alias)
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_REQUIRED=True
MILVUS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_graph_entity_names
ITEM_NAME_COLLECTION=kb_item_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75
MILVUS_KEEPALIVE_TIME_MS=300000
MILVUS_KEEPALIVE_TIMEOUT_MS=20000
MILVUS_KEEPALIVE_PERMIT_WITHOUT_CALLS=False

# Redis/task state. Use redis in production; memory is development-only.
REDIS_ENABLED=False
REDIS_URL=redis://127.0.0.1:6379/0
TASK_BACKEND=memory
TASK_TTL_SECONDS=86400
TASK_QUEUE_ENABLED=False
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_MAX_RETRIES=3
CLEANUP_MAX_RETRIES=5
CLEANUP_RETRY_BASE_SECONDS=5
CLEANUP_RETRY_MAX_SECONDS=600

# SQL metadata store. SQLite is a development fallback; production uses PostgreSQL.
DATABASE_ENABLED=True
DATABASE_URL=sqlite:///./data/knowledge_base.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# LangGraph state persistence. Production requires postgres and an AES key.
LANGGRAPH_CHECKPOINTER=sqlite
LANGGRAPH_CHECKPOINT_PATH=./data/langgraph_checkpoints.sqlite
LANGGRAPH_DATABASE_URL=
LANGGRAPH_AES_KEY=

# MinIO. Disabled development mode stores files below output/. Production requires
# private MinIO credentials; never enable anonymous/public bucket reads.
MINIO_ENABLED=False
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=images
MINIO_PDF_DIR=pdf_files
MINIO_SECURE=False
MINIO_PUBLIC_READ=False
MINIO_PRESIGNED_EXPIRY_SECONDS=3600

# Optional web search
WEB_SEARCH_ENABLED=False
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# Upload controls
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.md,.markdown
UPLOAD_MAX_FILE_SIZE_MB=50
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_MAX_FILENAME_LENGTH=180
UPLOAD_CHUNK_SIZE_BYTES=1048576

# Health checks
HEALTH_DEPENDENCY_TIMEOUT_SECONDS=2
