# Copy to .env.staging or inject these variables from a secret manager.
# Never commit real values.
POSTGRES_USER=knowledge_owner
POSTGRES_DB=knowledge_base
POSTGRES_PASSWORD=replace-in-secret-manager
POSTGRES_RUNTIME_PASSWORD=replace-in-secret-manager
REDIS_PASSWORD=replace-in-secret-manager
MINIO_ACCESS_KEY=replace-in-secret-manager
MINIO_SECRET_KEY=replace-in-secret-manager
LANGGRAPH_AES_KEY=replace-with-16-24-or-32-byte-key
OIDC_ISSUER_URL=https://identity.example.com/realms/enterprise
OIDC_CLIENT_ID=enterprise-rag
OIDC_CLIENT_SECRET=replace-in-secret-manager
OIDC_AUDIENCE=enterprise-rag-api
OIDC_REDIRECT_URI=https://127.0.0.1:8444/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://127.0.0.1:8444/chat.html
OIDC_SESSION_ENCRYPTION_KEY=replace-with-exactly-32-byte-key
OPENAI_API_KEY=replace-in-secret-manager
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_INPUT_COST_PER_1M_TOKENS=0
MODEL_OUTPUT_COST_PER_1M_TOKENS=0
MINERU_API_TOKEN=replace-in-secret-manager
STAGING_PUBLIC_HOST=127.0.0.1
