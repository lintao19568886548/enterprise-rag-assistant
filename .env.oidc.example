# Copy to .env.oidc for the isolated local Keycloak test stack.
# Never reuse these values in staging or production and never commit .env.oidc.
LOCAL_KEYCLOAK_ADMIN_USERNAME=local-admin
LOCAL_KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-local-value
LOCAL_OIDC_CLIENT_SECRET=replace-with-a-random-local-value
LOCAL_OIDC_USER_PASSWORD=replace-with-a-random-local-value
LOCAL_OIDC_REDIS_PASSWORD=replace-with-a-random-local-value
