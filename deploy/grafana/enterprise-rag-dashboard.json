      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, workflow, node) (rate(kb_workflow_node_duration_seconds_bucket[5m])))", "legendFormat": "{{workflow}} / {{node}}", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Model calls and latency", "id": 7, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 13},
