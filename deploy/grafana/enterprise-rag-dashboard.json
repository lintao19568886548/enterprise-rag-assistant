  "panels": [
    {
      "type": "stat", "title": "API request rate", "id": 1, "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(kb_http_requests_total[5m]))", "legendFormat": "requests/s", "refId": "A"}]
    },
    {
      "type": "stat", "title": "5xx error rate", "id": 2, "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}}},
      "targets": [{"expr": "sum(rate(kb_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(kb_http_requests_total[5m])), 1)", "refId": "A"}]
    },
    {
      "type": "stat", "title": "HTTP requests in flight", "id": 3, "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum by (service) (kb_http_requests_in_flight)", "legendFormat": "{{service}}", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Estimated model cost (24h)", "id": 4, "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [{"expr": "sum(increase(kb_model_estimated_cost_usd_total[24h]))", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "HTTP p50 / p95 / p99", "id": 5, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, service) (rate(kb_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{service}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, service) (rate(kb_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{service}}", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le, service) (rate(kb_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99 {{service}}", "refId": "C"}
      ]
    },
    {
      "type": "timeseries", "title": "LangGraph stage p95", "id": 6, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
